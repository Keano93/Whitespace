{
  "name": "headstart",
  "version": "2.0.0-phase1",
  "private": true,
  "scripts": {
    "setup": "node scripts/ensure-env.mjs && prisma db push --skip-generate && prisma generate && tsx scripts/load.ts --if-empty",
    "predev": "npm run setup --silent",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:generate": "tsx scripts/generate-seed.ts",
    "load": "tsx scripts/load.ts",
    "engine": "tsx scripts/run-engine.ts",
    "opportunities": "tsx scripts/opportunities.ts",
    "eval:extraction": "tsx scripts/eval-extraction.ts",
    "db:reset": "prisma db push --force-reset --skip-generate && tsx scripts/load.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@prisma/client": "^6.19.3",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
