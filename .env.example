# SQLite file used by Prisma (relative to prisma/schema.prisma)
DATABASE_URL="file:./headstart.db"

# Claude API: optional. Without a key, Headstart uses the committed extraction cache
# (data/cache/extractions.json) and the rule-based extractor for anything not cached.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
ANTHROPIC_EFFORT="low"   # low | medium | high

# Extractor: auto (Claude if a key is set, else rules) | claude | rules
HEADSTART_EXTRACTOR="auto"

# "Today" for timing / why-now maths. Leave empty for the real date; the seed data is built around 2026-11-10.
HEADSTART_TODAY="2026-11-10"
